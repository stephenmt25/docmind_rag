# Copy to .env (in the repo root) and fill in your values.

# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Postgres with the pgvector extension.
# This default matches docker-compose.yml; for Supabase, use your project's connection string.
DATABASE_URL=postgresql://docmind:docmind@127.0.0.1:5432/docmind
